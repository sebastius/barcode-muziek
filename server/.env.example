# Discogs personal access token (https://www.discogs.com/settings/developers). Optioneel: zonder token alleen MusicBrainz.
DISCOGS_TOKEN=
# Home Assistant URL en long-lived access token (Profiel -> Beveiliging)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Music Assistant player(s) in HA, komma-gescheiden. Voor meerdere HomePods tegelijk: maak een player group in MA.
HA_PLAYERS=media_player.woonkamer
PORT=8080
CACHE_FILE=/data/cache.json
